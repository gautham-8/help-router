# Help Router — environment configuration
# Copy this file to .env in the repo root (cp .env.example .env). The backend reads
# the repo-root .env and backend/.env (backend/.env wins). Process environment
# variables beat both files.
#
# The defaults below run the whole app and the test suite with NO API keys.

# Where speech and sound analysis happens:
#   browser (default) the caller's browser transcribes speech and classifies sounds on the
#                     device and sends text + sound labels. No keys.
#   mock              every report plays a scripted scenario. No keys. (A report that names
#                     a demo scenario, i.e. /?demo=1, always uses this, whatever is set.)
#   live              server-side models. Needs the keys below, and the speech/sound
#                     adapters are NOT implemented yet, so it only fails with a clear error.
ANALYZER_BACKEND=browser

# --- Routing thresholds (see .kiro/specs/help-capture-and-routing/design.md §3) ---
# A service is routed at or above this confidence.
MIN_SERVICE_CONF=0.3
# A service at or above this is "committed" and is never dropped silently.
HIGH_CONF=0.7
# Each new chunk keeps this fraction of the previous confidence (fades without evidence).
CARRY_DECAY=0.85
# A smoke_alarm must be at least this confident to force "fire".
GUARANTEE_MIN_EVENT_CONF=0.5

# --- Access control ---
# Optional shared secret for the dashboard, queues, and confirm/reject. Empty = open,
# which is fine for a local demo. SET THIS before exposing the app on any public URL,
# then open the dashboard as /dashboard?token=<value>.
DASHBOARD_TOKEN=

# Browser origins allowed to call the API directly (comma-separated). The Vite dev
# server proxies API calls, so the default is enough for local use.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# ---------------------------------------------------------------------------
# Only needed when ANALYZER_BACKEND=live. Leave blank for the mock demo.
# Never commit real values; .env is gitignored.
# ---------------------------------------------------------------------------
# Speech-to-text / LLM router provider key (e.g. OpenAI).
OPENAI_API_KEY=
# Audio-event classification model endpoint/key.
AUDIO_EVENT_MODEL_URL=
AUDIO_EVENT_MODEL_KEY=
